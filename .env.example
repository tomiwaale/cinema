# NEXT_PUBLIC_APP_URL: The URL where the app is hosted.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PAYSTACK_SECRET_KEY: Paystack payment gateway secret key (server-side only).
# Get your keys at https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY="sk_test_your_key_here"

# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY: Paystack public key (used client-side for payment modal).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_your_key_here"

# SMTP credentials for sending booking confirmation emails (optional for MVP).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your@email.com"
SMTP_PASS="your_app_password"
